---
import PricingCheckout from "./PricingCheckout";
import DynamicIcon from "@/helpers/DynamicIcon";
import type { Pricing } from "@/types";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getMessages } from "@/lib/messages";
import { planAmounts } from "@/lib/locale-pricing";

type Props = Pricing["plans"][number] & {
  locale: Locale;
  canonicalPlan: Pricing["plans"][number];
};
const {
  plan_id,
  locale,
  canonicalPlan,
  title,
  is_featured,
  button,
  description,
  features,
} = Astro.props;
if (plan_id !== canonicalPlan.plan_id) {
  throw new Error("Localized plan must retain its canonical plan ID.");
}
const planId = canonicalPlan.plan_id;
const id = `plan-${planId}`;
const copy = getMessages(locale);
const amounts = planAmounts(canonicalPlan, Astro.props, locale);
---

<article
  class:list={["pricing-plan", { "pricing-plan-featured": is_featured }]}
  aria-labelledby={id}
  data-plan-id={planId}
>
  <div>
    <h3 id={id} class="mb-3 text-2xl">{title}</h3>
    <p class="plan-description">{description}</p>
    <p
      class="plan-price"
      data-billing-price="month"
      data-currency={amounts.currency}
      data-amount-minor={amounts.month}
    >
      <strong>{amounts.monthlyDisplay}</strong><span>/{copy.pricing.month}</span>
    </p>
    <p
      class="plan-price"
      data-billing-price="year"
      data-currency={amounts.currency}
      data-amount-minor={amounts.year}
      hidden
    >
      <strong>{amounts.yearlyDisplay}</strong><span>/{copy.pricing.year}</span>
    </p>
    <div class="my-6">
      {
        button.enable && planId === "starter" ? (
          <>
            <PricingCheckout
              client:load
              locale={locale}
              planId={planId}
              planTitle={title}
              monthlyAmountMinor={amounts.month}
              yearlyAmountMinor={amounts.year}
              buttonLabel={button.label}
              copy={copy.checkout}
            />
            <noscript>
              <p class="mt-3 text-sm">
                {copy.pricing.noCheckout}{" "}
                <a href={localizeHref(button.link, locale)} class="link">
                  {copy.checkout.contact}
                </a>{" "}
                {copy.pricing.instead}
              </p>
            </noscript>
          </>
        ) : (
          <a
            class="btn btn-outline w-full"
            href={localizeHref(button.link, locale)}
          >
            {button.label}
          </a>
        )
      }
    </div>
    <h4 class="mb-5 text-base font-semibold">{copy.pricing.published}</h4>
    <ul class="space-y-4">
      {
        features.map((feature) => (
          <li class="flex items-start gap-3">
            <DynamicIcon
              icon={feature.included ? "FaCheck" : "FaMinus"}
              className="mt-1 shrink-0 text-sm text-primary"
              aria-hidden="true"
            />
            <div>
              <span class="sr-only">
                {feature.included
                  ? `${copy.pricing.included}: `
                  : `${copy.pricing.notIncluded}: `}
              </span>
              <span>{feature.label}</span>
              {feature.tooltip && (
                <p class="mt-1 text-sm text-text-dark">{feature.tooltip}</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</article>
