---
interface Props {
  number: string;
  title: string;
  content: string;
}
const { number, title, content } = Astro.props;
---

<div
  class="grid items-start gap-4 border-t border-border py-6 md:grid-cols-[3rem_10rem_1fr] md:gap-8"
>
  <span class="text-xl font-semibold text-primary" aria-hidden="true"
    >{number}</span
  >
  <h3 class="text-xl">{title}</h3>
  <p>{content}</p>
</div>
