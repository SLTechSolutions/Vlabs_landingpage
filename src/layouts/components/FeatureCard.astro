---
import ImageMod from "./ImageMod.astro";
import type { FeatureItem } from "@/types";

type Props = FeatureItem;
const { logo, title, content } = Astro.props;
---

<article class="border-t border-border py-7 md:pr-6">
  <ImageMod
    src={logo}
    alt=""
    width={40}
    height={40}
    class="mb-5 size-10 theme-icon"
  />
  <h3 class="mb-3 text-xl">{title}</h3>
  <p>{content}</p>
</article>
